---
import Layout from '../layouts/Layout.astro';
import SakuraFall from '../components/SakuraFall.astro';
import teamData from '../data/team.json';
import site from '../data/site.json';

const AVATAR_COLORS = ['#e50914', '#ffb7c5', '#ff4d57', '#8a050c', '#c2185b'];
const AVATAR_TEXT = ['#ffffff', '#3d0a10', '#ffffff', '#ffffff', '#ffffff'];

function initials(name: string): string {
  return name
    .replace(/\(.*?\)/g, '')
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}

let avatarIndex = 0;
---

<Layout
  title="Equipe"
  description="Conheça a equipe de voluntários que faz o AnimeIngá acontecer.">
  <section class="page-hero">
    <SakuraFall density={18} />
    <div class="container--narrow reveal" style="position: relative; z-index: 1;">
      <h1 class="page-hero__title">Quem faz acontecer</h1>
      <p class="page-hero__subtitle">
        O AnimeIngá é feito por voluntários apaixonados por cultura pop.
        Conheça as pessoas por trás da edição 2026.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {teamData.departments.map((dept) => {
        const members = teamData.members.filter((m) => m.department === dept.name);
        if (members.length === 0) return null;
        return (
          <div class="department">
            <div class="reveal">
              <h2 class="department__name">{dept.name}</h2>
              <p class="department__description">{dept.description}</p>
            </div>
            <div class="team-grid">
              {members.map((member, i) => {
                const colorIdx = avatarIndex++ % AVATAR_COLORS.length;
                const color = AVATAR_COLORS[colorIdx];
                const textColor = AVATAR_TEXT[colorIdx];
                return (
                  <div class="reveal" style={`--reveal-delay: ${(i % 4) * 100}ms`}>
                    <div class="tilt" data-max-tilt="8">
                      <article class="card member-card">
                        {member.photo ? (
                          <img class="member-card__avatar" src={member.photo} alt={`Foto de ${member.name}`} loading="lazy" />
                        ) : (
                          <span
                            class="member-card__avatar member-card__avatar--initials"
                            style={`background: ${color}; color: ${textColor}`}
                            aria-hidden="true">
                            {initials(member.name)}
                          </span>
                        )}
                        <h3 class="member-card__name">{member.name}</h3>
                        {member.role && <p class="member-card__role">{member.role}</p>}
                        {member.bio && <p class="member-card__bio">{member.bio}</p>}
                        {member.links.length > 0 && (
                          <div class="member-card__links">
                            {member.links.map((link) => (
                              <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                            ))}
                          </div>
                        )}
                      </article>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}

      <div class="volunteer reveal" style="--reveal-delay: 200ms">
        <h2 class="volunteer__title">Quer fazer parte da equipe? 🌸</h2>
        <p class="volunteer__text">
          Estamos sempre em busca de voluntários para a edição 2026.
        </p>
        <a
          class="btn btn--primary"
          href={`mailto:${site.contact.email}?subject=${encodeURIComponent('Quero ser voluntário — AnimeIngá 2026')}`}>
          Quero ser voluntário
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: clamp(4rem, 9vw, 6.5rem) 0;
  }

  .department {
    margin-bottom: 4rem;
  }

  .department__name {
    font-weight: 900;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    margin-bottom: 0.3rem;
    padding-left: 1rem;
    border-left: 4px solid var(--color-primary);
  }

  .department__description {
    color: var(--color-text-muted);
    margin: 0 0 1.8rem;
    padding-left: 1rem;
    font-size: 0.95rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 1.5rem;
  }

  .member-card {
    height: 100%;
    text-align: center;
    padding: 1.9rem 1.5rem;
  }

  .member-card__avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1rem;
    display: block;
    border: 3px solid rgba(229, 9, 20, 0.45);
    box-shadow: 0 0 30px rgba(229, 9, 20, 0.25);
  }

  .member-card__avatar--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
  }

  .member-card__name {
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .member-card__role {
    color: var(--color-primary-light);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0.4rem 0 0;
  }

  .member-card__bio {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.7;
    margin: 1rem 0 0;
  }

  .member-card__links {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.2rem;
  }

  .member-card__links a {
    padding: 0.35rem 0.9rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .member-card__links a:hover {
    border-color: var(--color-primary-light);
    color: var(--color-primary-light);
  }

  .volunteer {
    text-align: center;
    margin-top: 2rem;
  }

  .volunteer__title {
    font-weight: 800;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    margin-bottom: 0.6rem;
  }

  .volunteer__text {
    color: var(--color-text-muted);
    margin: 0 0 1.6rem;
  }
</style>
