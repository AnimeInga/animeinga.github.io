---
import Layout from '../layouts/Layout.astro';
import SakuraFall from '../components/SakuraFall.astro';
import data from '../data/competitions.json';
import site from '../data/site.json';
import {STATUS_LABEL} from '../lib/competitions';
---

<Layout title="Regulamentos & Competições" description={data.page.subtitle}>
  <section class="page-hero">
    <SakuraFall density={18} />
    <div class="container--narrow reveal" style="position: relative; z-index: 1;">
      <span class="chip">{site.dates.shortLabel}</span>
      <h1 class="page-hero__title" style="margin-top: 1rem;">{data.page.title}</h1>
      <p class="page-hero__subtitle">{data.page.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice reveal" role="note">
        <span aria-hidden="true">📢</span>
        <p>{data.page.notice}</p>
      </div>

      <div class="competitions-grid">
        {data.competitions.map((comp, i) => (
          <div class:list={['reveal', i === 0 ? 'reveal--left' : 'reveal--right']} style={`--reveal-delay: ${i * 150}ms`}>
            <article class="competition-card">
              <span class:list={['competition-card__ribbon', {'competition-card__ribbon--active': comp.status === 'inscricoes'}]}>
                {STATUS_LABEL[comp.status] ?? comp.status}
              </span>

              <span class="competition-card__icon">{comp.icon}</span>
              <h2 class="competition-card__title">{comp.title}</h2>
              <p class="competition-card__tagline">{comp.tagline}</p>
              <p class="competition-card__description">{comp.description}</p>

              <ul class="competition-card__highlights">
                {comp.highlights.map((h) => (
                  <li><span aria-hidden="true">✦</span> {h}</li>
                ))}
              </ul>

              {comp.id === 'esports' && (
                <div class="esports-details">
                  <section class="esports-block" aria-labelledby="esports-regulations-title">
                    <h3 id="esports-regulations-title">Regulamentos oficiais</h3>
                    <ul class="esports-regulations">
                      {comp.regulations.map((regulation) => (
                        <li>
                          <span>{regulation.title}</span>
                          <a
                            class="btn btn--ghost"
                            href={regulation.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            download>
                            Baixar regulamento (PDF)
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>

                  <section class="esports-block" aria-labelledby="esports-prizes-title">
                    <h3 id="esports-prizes-title">Premiação por modalidade</h3>
                    <ul>
                      {comp.prizes.map((prize) => <li>{prize}</li>)}
                    </ul>
                  </section>

                  <section class="esports-block" aria-labelledby="esports-schedule-title">
                    <h3 id="esports-schedule-title">Cronograma</h3>
                    <p><strong>Fases online:</strong></p>
                    <ul>
                      {comp.schedule.online.map((date) => <li>{date}</li>)}
                    </ul>
                    <p><strong>Fases presenciais:</strong></p>
                    <ul>
                      {comp.schedule.inPerson.map((date) => <li>{date}</li>)}
                    </ul>
                    <p><strong>Local:</strong> {comp.schedule.venue}</p>
                  </section>

                  <p class="esports-registration-note">{comp.registrationNote}</p>
                </div>
              )}

              <div class="competition-card__actions">
                {comp.id !== 'esports' && (
                  comp.regulationUrl ? (
                    <a
                      class="btn btn--primary"
                      href={comp.regulationUrl}
                      target={comp.regulationUrl.startsWith('http') ? '_blank' : undefined}
                      rel={comp.regulationUrl.startsWith('http') ? 'noopener noreferrer' : undefined}>
                      Ver regulamento
                    </a>
                  ) : (
                    <span class="btn btn--disabled" title="O regulamento será publicado em breve">
                      Regulamento em breve
                    </span>
                  )
                )}
                {comp.registrationUrl ? (
                  <a class="btn btn--ghost" href={comp.registrationUrl} target="_blank" rel="noopener noreferrer">
                    {comp.id === 'esports' ? 'Inscreva sua equipe na Sympla' : 'Inscrever-se'}
                  </a>
                ) : (
                  <span class="btn btn--disabled" title="As inscrições abrirão em breve">
                    Inscrições em breve
                  </span>
                )}
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: clamp(4rem, 9vw, 6.5rem) 0;
  }

  .notice {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.1rem 1.4rem;
    margin-bottom: 3rem;
    border-radius: var(--radius);
    background: rgba(229, 9, 20, 0.08);
    border: 1px solid rgba(229, 9, 20, 0.35);
    color: rgba(255, 255, 255, 0.85);
  }
  .notice p {
    margin: 0;
    line-height: 1.7;
  }

  .competitions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 2rem;
  }

  .competition-card {
    position: relative;
    overflow: hidden;
    height: 100%;
    border-radius: var(--radius);
    background: linear-gradient(165deg, rgba(229, 9, 20, 0.12) 0%, rgba(10, 10, 10, 0.95) 50%);
    border: 1px solid rgba(229, 9, 20, 0.35);
    padding: clamp(1.8rem, 4vw, 2.6rem);
  }

  /* Fita diagonal "EM BREVE" no canto do card */
  .competition-card__ribbon {
    position: absolute;
    top: 22px;
    right: -44px;
    transform: rotate(38deg);
    width: 190px;
    text-align: center;
    padding: 0.45rem 0;
    font-weight: 900;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: #fff;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-dark));
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    z-index: 2;
  }
  .competition-card__ribbon--active {
    color: #050505;
    background: linear-gradient(90deg, var(--color-sakura), var(--color-primary-light));
  }

  .competition-card__icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.8rem;
  }

  .competition-card__title {
    font-weight: 900;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.3rem;
  }

  .competition-card__tagline {
    color: var(--color-sakura);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin: 0 0 1.4rem;
  }

  .competition-card__description {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.8;
    margin: 0 0 1.6rem;
  }

  .competition-card__highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 2.2rem;
    display: grid;
    gap: 0.6rem;
  }

  .competition-card__highlights li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
  }

  .competition-card__highlights span {
    color: var(--color-primary-light);
    font-weight: 900;
  }

  .competition-card__actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .esports-details {
    display: grid;
    gap: 1.5rem;
    margin: 0 0 2rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
  }

  .esports-block h3 {
    margin: 0 0 0.6rem;
    color: var(--color-sakura);
    font-size: 1.05rem;
  }

  .esports-block ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .esports-block p {
    margin: 0.5rem 0 0.2rem;
  }

  .esports-regulations {
    display: grid;
    gap: 0.7rem;
    padding: 0 !important;
    list-style: none;
  }

  .esports-regulations li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .esports-regulations .btn {
    font-size: 0.8rem;
    padding: 0.55rem 0.8rem;
  }

  .esports-registration-note {
    margin: 0;
    padding: 1rem;
    border-left: 3px solid var(--color-primary-light);
    background: rgba(255, 255, 255, 0.04);
  }
</style>
