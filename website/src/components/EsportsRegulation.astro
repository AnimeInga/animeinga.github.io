---
import Layout from '../layouts/Layout.astro';
import SakuraFall from './SakuraFall.astro';
import site from '../data/site.json';

interface Regulation {
  page: {
    title: string;
    subtitle: string;
  };
  registrationUrl: string;
  price: string;
  sections: {
    id: string;
    num?: string;
    title: string;
    paragraphs: string[];
    entries?: {
      data: string;
      evento: string;
    }[];
  }[];
}

interface Props {
  regulation: Regulation;
}

const {regulation} = Astro.props;
---

<Layout title={regulation.page.title} description={regulation.page.subtitle}>
  <section class="page-hero">
    <SakuraFall density={18} />
    <div class="container--narrow reveal" style="position: relative; z-index: 1;">
      <span class="chip">{site.dates.shortLabel}</span>
      <h1 class="page-hero__title" style="margin-top: 1rem;">{regulation.page.title}</h1>
      <p class="page-hero__subtitle">{regulation.page.subtitle}</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={regulation.registrationUrl} target="_blank" rel="noopener noreferrer">
          Inscreva sua equipe na Sympla
        </a>
        <span class="price-tag">{regulation.price}</span>
      </div>
    </div>
  </section>

  <div class="section container--narrow">
    <nav class="toc reveal" aria-label="Sumário do regulamento">
      <p class="toc__title">Neste regulamento</p>
      <ol>
        {regulation.sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>
              {section.num ? `${section.num}. ` : ''}{section.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {regulation.sections.map((section) => (
      <section id={section.id} class="reg-section reveal">
        <h2 class="reg-section__title">
          {section.num ? `${section.num}. ` : ''}{section.title}
        </h2>
        {section.entries && (
          <ol class="timeline">
            {section.entries.map((entry) => (
              <li class="timeline__item">
                <span class="timeline__date">{entry.data}</span>
                <span class="timeline__evento">{entry.evento}</span>
              </li>
            ))}
          </ol>
        )}
        {section.paragraphs.map((paragraph) => (
          <p class="reg-text">{paragraph}</p>
        ))}
      </section>
    ))}
  </div>
</Layout>

<style>
  .section {
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(4rem, 9vw, 6.5rem);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 2.2rem;
  }

  .price-tag {
    padding: 0.55rem 1.2rem;
    border: 1px dashed rgba(255, 183, 197, 0.45);
    border-radius: 10px;
    color: var(--color-sakura);
    font-weight: 800;
  }

  .toc {
    margin-bottom: 3rem;
    padding: 1.5rem 1.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .toc__title {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .toc ol {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.35rem;
  }

  .toc li::marker {
    color: var(--color-primary-light);
    font-weight: 700;
  }

  .toc a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-primary-light);
  }

  .reg-section {
    padding: 2.4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    scroll-margin-top: calc(var(--navbar-height) + 1.25rem);
  }

  .reg-section__title {
    margin-bottom: 1.4rem;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 900;
  }

  .reg-text {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.8;
  }

  .timeline {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(150px, 0.8fr) 2fr;
    gap: 1.2rem;
    align-items: baseline;
    padding: 1rem 1.3rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .timeline__date {
    color: var(--color-sakura);
    font-weight: 900;
  }

  .timeline__evento {
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .timeline__item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
